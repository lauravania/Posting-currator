# Dropbox API credentials
# Create an app at https://www.dropbox.com/developers/apps (Scoped access,
# "Full Dropbox" or "App folder" as needed) and enable these scopes:
#   files.metadata.read, files.content.read, sharing.read
#
# APP_KEY / APP_SECRET come from the app's settings page.
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here

# Long-lived refresh token. Generate one with scripts/0_get_refresh_token.py
# after setting DROPBOX_APP_KEY / DROPBOX_APP_SECRET above.
DROPBOX_REFRESH_TOKEN=your_refresh_token_here

# The Dropbox shared folder link to pull wedding photos from, e.g.
# https://www.dropbox.com/scl/fo/xxxxxxxx/xxxxxxxx?rlkey=xxxxxxxx&dl=0
DROPBOX_SHARED_FOLDER_URL=https://www.dropbox.com/scl/fo/xxxxxxxx/your-folder?dl=0
