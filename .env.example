# Dropbox API credentials
# Create an app at https://www.dropbox.com/developers/apps
# and generate a refresh token via the OAuth2 authorization code flow
# (see README.md for step-by-step instructions).

DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here
DROPBOX_REFRESH_TOKEN=your_refresh_token_here

# Shared folder link to pull wedding photos from, e.g.
# https://www.dropbox.com/scl/fo/xxxxxxxx/xxxxxxxx?rlkey=xxxxxxxx&dl=0
DROPBOX_SHARED_LINK=https://www.dropbox.com/scl/fo/your_shared_folder_link
