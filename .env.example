# Copy this file to `.env` and fill in the values below.
# Never commit your real `.env` file — it is already listed in .gitignore.

# Dropbox App key/secret from https://www.dropbox.com/developers/apps
# (create an app with "Scoped access" + the files.metadata.read and
# files.content.read permissions, or "Full Dropbox"/"App folder" access
# depending on where the shared folder lives).
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here

# Long-lived refresh token for your Dropbox app.
# Generate one by running: python scripts/0_get_refresh_token.py
DROPBOX_REFRESH_TOKEN=your_refresh_token_here

# The Dropbox shared folder link you want to pull photos from, e.g.
# https://www.dropbox.com/scl/fo/abc123xyz/AbCdEfGh?rlkey=...&dl=0
DROPBOX_SHARED_FOLDER_LINK=https://www.dropbox.com/scl/fo/your_shared_folder_link_here
