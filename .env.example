# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` file — it is already listed in .gitignore.

# Dropbox App console: https://www.dropbox.com/developers/apps
# Create a "Scoped access" app with the following scopes enabled:
#   files.metadata.read, files.content.read, sharing.read
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here

# Long-lived refresh token obtained once via the OAuth2 authorization-code
# flow (see README.md "Getting a refresh token"). The fetch script uses this
# to mint short-lived access tokens automatically on every run, so you never
# need to re-authenticate by hand.
DROPBOX_REFRESH_TOKEN=your_refresh_token_here

# The shared folder link you want to pull photos from, e.g.
# https://www.dropbox.com/scl/fo/abc123/xyz?rlkey=...&dl=0
DROPBOX_SHARED_LINK=https://www.dropbox.com/scl/fo/your_shared_folder_link
