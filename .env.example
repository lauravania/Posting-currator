# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file — it is already listed in .gitignore.

# Dropbox App console: https://www.dropbox.com/developers/apps
# Create a "Scoped access" app with the following permissions (scopes) enabled:
#   files.metadata.read, files.content.read, sharing.read
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret

# Long-lived refresh token obtained via the OAuth2 "offline access" flow.
# See README.md for step-by-step instructions on generating this once.
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token

# The Dropbox shared folder link containing the wedding photos, e.g.
# https://www.dropbox.com/scl/fo/abcdef1234/xyz?rlkey=abc123&dl=0
DROPBOX_SHARED_LINK=https://www.dropbox.com/scl/fo/your_shared_folder_link
