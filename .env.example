# Copy this file to `.env` (already done for you by the app's Settings page —
# you should not need to edit this by hand). Every field here can be filled
# in and saved from http://127.0.0.1:5000/settings instead.

# Flask session secret (auto-generated on first run if missing)
FLASK_SECRET_KEY=

# Dropbox App key/secret from https://www.dropbox.com/developers/apps
# (Scoped access app with files.metadata.read / files.content.read /
# sharing.read permissions, and an OAuth2 redirect URI of
# http://127.0.0.1:5000/api/dropbox/oauth/callback registered in the app's
# settings page on Dropbox's site.)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Filled in automatically by the "Connect Dropbox" button on the Settings page.
DROPBOX_REFRESH_TOKEN=

# The Dropbox shared folder link containing the wedding photos, e.g.
# https://www.dropbox.com/scl/fo/abc123xyz/AbCdEfGh?rlkey=...&dl=0
DROPBOX_SHARED_FOLDER_LINK=

# Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
