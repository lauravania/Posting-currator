# Dropbox API credentials
# ------------------------
# Create an app at https://www.dropbox.com/developers/apps
# (Scoped access, permission type "Full Dropbox" or "App folder",
# with the `sharing.read` and `files.content.read` scopes enabled).
#
# APP_KEY / APP_SECRET come from the app's settings page.
#
# REFRESH_TOKEN is long-lived and does not expire. Generate one with:
#   python scripts/get_dropbox_refresh_token.py
# after filling in DROPBOX_APP_KEY and DROPBOX_APP_SECRET below.
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here
DROPBOX_REFRESH_TOKEN=your_refresh_token_here

# The Dropbox shared folder link to pull wedding photos from.
DROPBOX_SHARED_LINK=https://www.dropbox.com/scl/fo/xxxxxxxx/xxxxxxxx?rlkey=xxxxxxxx&dl=0
