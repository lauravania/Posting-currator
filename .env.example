# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file (it's already in .gitignore).

# Dropbox app credentials — from https://www.dropbox.com/developers/apps
# Create an app with "Scoped access" and the following permissions (scopes):
#   sharing.read, files.metadata.read, files.content.read
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here

# Long-lived refresh token for your Dropbox app, generated once via
# scripts/get_refresh_token.py (see README.md for instructions).
DROPBOX_REFRESH_TOKEN=your_refresh_token_here

# The shared folder link you want to pull wedding photos from.
# e.g. https://www.dropbox.com/scl/fo/abc123xyz/AbCdEfGh?rlkey=xxxxxxxx&dl=0
DROPBOX_SHARED_LINK=https://www.dropbox.com/scl/fo/your_shared_folder_link
