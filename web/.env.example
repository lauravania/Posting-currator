# Copy to .env and fill in. Never commit the real .env file.

# PostgreSQL connection string. Point this at Supabase Postgres in
# production (Project Settings -> Database -> Connection string).
DATABASE_URL="postgresql://user:password@localhost:5432/wmi_dev?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI (optional). Leave unset to run in Demo Mode: real Sharp-based image
# heuristics for scoring + rule-based copywriting instead of live model
# calls. Required for genuine vision-model photo scoring and generative
# captions/opportunity detection.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
OPENAI_TEXT_MODEL="gpt-4o-mini"

# Storage. "local" (default) writes uploads under ./public/uploads — fine
# for a single-instance/demo deployment. Set to "s3" and fill the S3_* vars
# to use S3 or Supabase Storage (S3-compatible) in production.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""

# Encrypts stored Google Drive / Dropbox OAuth tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Falls back to a key derived from NEXTAUTH_SECRET if unset, so cloud import
# still works in local dev without this — set a dedicated key in production.
TOKEN_ENCRYPTION_KEY=""

# --- Google Drive cloud photo import (both optional; either enables the tab) ---
#
# EASIEST — "drop a link" (no OAuth consent screen, works on any folder
# shared as "Anyone with the link"):
#   1. console.cloud.google.com -> select/create a project
#   2. "APIs & Services" -> "Library" -> enable the "Google Drive API"
#   3. "APIs & Services" -> "Credentials" -> "Create Credentials" -> "API key"
#   4. (recommended) restrict the key to the Google Drive API
#   5. Paste it below. That's it — no redirect URI, no consent screen.
GOOGLE_DRIVE_API_KEY=""
#
# FULL OAUTH — adds a "Connect" flow that also reaches private folders:
#   "APIs & Services" -> "Credentials" -> "Create OAuth client ID"
#   (type: Web application) -> add authorized redirect URI:
#     <your app URL>/api/integrations/google-drive/callback
#   (e.g. http://localhost:3000/api/integrations/google-drive/callback for
#   local dev). Scopes requested at runtime: drive.readonly, userinfo.email.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""

# --- Dropbox cloud photo import (both blocks optional; either enables the tab) ---
#
# EASIEST — "drop a link" (no per-user OAuth consent screen, works on any
# Dropbox share link). One admin generates this ONCE:
#   1. dropbox.com/developers/apps -> create app (Scoped access, "Full
#      Dropbox" or "App folder") -> note the App key / App secret below
#   2. Enable the files.metadata.read and files.content.read permissions
#   3. Run: python scripts/get_dropbox_refresh_token.py
#      (already in this repo — same flow scripts/1_fetch_photos.py uses)
#   4. Paste the printed refresh token below
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
DROPBOX_REFRESH_TOKEN=""
#
# FULL OAUTH — adds a per-user "Connect" flow (uses the same App key/secret
# above). Under the app's "OAuth 2" settings, add redirect URI:
#   <your app URL>/api/integrations/dropbox/callback
