# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit secrets — see .env.example for the required vars)
.env
.env*.local

# user-uploaded photos (local storage driver only — not used when
# STORAGE_DRIVER=s3)
/public/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Claude Code skill artifacts auto-installed by tooling (e.g. prisma init) —
# not part of the application.
/.agents/
/.claude/skills/
/.windsurf/
/skills-lock.json
